<% const isFocused = Boolean(locals.currentCode); %>
<% const hasLabels = Boolean(locals.getLabel); %>
<% const renderLabel = area => include('./_label.ejs', { area, lines: [getLabel(area.code)].flat() }); %>
<div class="voivodeship-map-frame">
	<%- include('../includes/map-glass.ejs') %>
	<svg class="stats-map voivodeship-map<% if (isFocused) { %> voivodeship-map--focused<% } %>" viewBox="<%= voivodeshipMap.viewBox %>" role="group" aria-label="<%= label %>">
		<% voivodeshipMap.areas.forEach(area => { %><a href="/wojewodztwa/<%= area.slug %>" aria-label="Województwo <%= area.name %>"<% if (area.code === locals.currentCode) { %> aria-current="page"<% } %>><path class="stats-map__area" id="map-area-<%= area.code %>" d="<%= area.path %>" fill-opacity="<%= getOpacity(area.code) %>"></path><% if (isFocused && hasLabels) { %><%- renderLabel(area) %><% } %></a><% }) %>
		<% if (!isFocused && hasLabels) { voivodeshipMap.areas.forEach(area => { %><%- renderLabel(area) %><% }) } %>
	</svg>
</div>
<p class="stats-map__attribution"><% if (locals.note) { %><%= note %> <% } %>Granice województw: © autorzy <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a></p>
