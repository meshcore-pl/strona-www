<!DOCTYPE html> <%
const _basePath = locals.canonical || '/';
const _ogImage = getSeoImage(domain, locals.image, locals.articleTitle || title);
const _themeColor = locals.themeColor || defaultThemeColor;
%>
<html lang="pl">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title><%= title %></title>

	<!-- Primary meta -->
	<% if (locals.description) { %><meta name="description" content="<%= description %>"><% }
	if (locals.keywords) { %><meta name="keywords" content="<%= keywords %>"><% }
	if (locals.noindex) { %><meta name="robots" content="noindex, nofollow"><% }
	if (locals.canonical) { %><link rel="canonical" href="<%= domain %><%= _basePath %>"><% } %>
	<meta name="theme-color" content="<%= _themeColor %>">

	<!-- Open Graph -->
	<meta property="og:type" content="<%= locals.datePublished ? 'article' : 'website' %>">
	<meta property="og:site_name" content="MeshCore Polska">
	<meta property="og:locale" content="pl_PL">
	<meta property="og:title" content="<%= title %>">
	<% if (locals.description) { %><meta property="og:description" content="<%= description %>"><% } %>
	<meta property="og:url" content="<%= domain %><%= _basePath %>">
	<meta property="og:image" content="<%= _ogImage.url %>">
	<% if (!locals.image) { %><meta property="og:image:width" content="1200">
	<meta property="og:image:height" content="675">
	<% } %><meta property="og:image:alt" content="<%= _ogImage.alt %>">
	<% if (locals.datePublished) { %><meta property="article:published_time" content="<%= datePublished %>">
	<meta property="article:modified_time" content="<%= locals.dateModified || datePublished %>"><% } %>

	<!-- Twitter / X Card -->
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:title" content="<%= title %>">
	<% if (locals.description) { %><meta name="twitter:description" content="<%= description %>"><% } %>
	<meta name="twitter:image" content="<%= _ogImage.url %>">
	<meta name="twitter:image:alt" content="<%= _ogImage.alt %>">

	<!-- JavaScript -->
	<script src="<%= cdn %>/js/progressbar.js" crossorigin defer></script>

	<!-- Icons & manifest -->
	<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64 128x128 256x256">
	<link rel="icon" href="/images/logo/android-chrome-192x192.png" type="image/png" sizes="192x192">
	<link rel="apple-touch-icon" href="/images/logo/apple-touch-icon.png" sizes="180x180">
	<link rel="manifest" href="/manifest.webmanifest">

	<!-- RSS -->
	<% if (locals.feed) { %><link rel="alternate" type="application/rss+xml" title="<%= feed.title %>" href="<%= domain %><%= feed.href %>">
	<% } %><link rel="alternate" type="application/rss+xml" title="Aktualności MeshCore Polska" href="<%= domain %>/aktualnosci/rss.xml">

	<!-- Stylesheets -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="preconnect" href="<%= cdn %>" crossorigin>
	<link rel="stylesheet" href="<%= cdn %>/css/meshcore/toast.css" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,700;1,800;1,900&amp;family=IBM+Plex+Mono:wght@400;500;600&amp;display=swap" rel="stylesheet">

	<%
	const BASE_SHEETS = ['global'];
	const BUNDLES = {
		index: ['index', 'index/timeline', 'index/network', 'index/sections', 'index/cards', 'index/steps', 'index/profile', 'index/cta', 'index/responsive'],
		docs: ['docs', 'docs/cards', 'docs/layout', 'docs/sidebar', 'docs/content', 'docs/responsive'],
	};
	const pageSheets = (locals.css ? (Array.isArray(css) ? css : [css]) : []).flatMap(sheet => BUNDLES[sheet] || sheet);
	[...BASE_SHEETS, ...pageSheets].forEach(sheet => { %><link rel="stylesheet" href="<%= sheet.startsWith('http') ? sheet : `/css/${sheet}.css` %>"<%= sheet.startsWith('http') ? ' crossorigin' : '' %>>
	<% }) %>

	<!-- schema.org -->
	<script type="application/ld+json" data-seo>
	<%- JSON.stringify(buildSchema({
		domain,
		breadcrumbs: locals.breadcrumbs,
		article: locals.datePublished ? {
			title: locals.articleTitle || title,
			description: locals.description || '',
			datePublished,
			dateModified: locals.dateModified || datePublished,
			url: _basePath,
			image: locals.image ? _ogImage.url : undefined,
			type: locals.articleType,
			sourceUrl: locals.articleSourceUrl,
		} : null,
		faq: locals.faq,
	})).replace(/</g, '\\u003c') %>
	</script>
</head>
<body data-page="<%= locals.page || '' %>" data-cdn="<%= cdn %>">
<header id="nav">
	<div id="nav__inner">
		<a href="/" id="nav__brand">
			<img src="/images/logo/mark.png" alt="" width="48" height="34" id="nav__logo">
			<span>MeshCore <strong>Polska</strong></span>
		</a>

		<div id="nav__right">
			<nav id="nav-menu" aria-label="Menu główne">
				<a href="/dokumentacja" class="nav__link<%= locals.page === 'docs' ? ' nav__link--active' : '' %>" title="Dokumentacja projektu MeshCore Polska">Dokumentacja</a>
				<a href="/aktualnosci" class="nav__link<%= locals.page === 'news' ? ' nav__link--active' : '' %>" title="Aktualności i changelogi MeshCore">Aktualności</a>
				<a href="/generator-regionow" class="nav__link<%= locals.page === 'region-generator' ? ' nav__link--active' : '' %>" title="Generator komend CLI regionów dla repeaterów i companionów">Generator regionów</a>
				<a href="https://mapa.meshcorepolska.org" class="nav__link" target="_blank" title="Interaktywna mapa węzłów sieci MeshCore w Polsce" rel="noopener">Mapa węzłów</a>
				<a href="https://flasher.meshcore.io" class="nav__link" target="_blank" title="Narzędzie do wgrywania firmware MeshCore na urządzenia" rel="noopener">Flasher</a>
				<a href="/kontakt" class="nav__link<%= locals.page === 'contact' ? ' nav__link--active' : '' %>" title="Formularz kontaktowy">Kontakt</a>
				<a href="/discord" class="btn btn--primary" id="nav__links-cta" target="_blank" title="Dołącz do naszego serwera Discord" rel="noopener">Serwer Discord</a>
			</nav>
			<a href="/discord" class="btn btn--primary btn--sm" id="nav__cta" target="_blank" title="Dołącz do naszego serwera Discord" rel="noopener">Serwer Discord</a>
			<button id="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label="Menu">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
			</button>
		</div>
	</div>
</header>
