<%- include('../includes/header.ejs', {
	title: `Tag: ${tag.label} - Aktualności MeshCore Polska`,
	description: `Wpisy oznaczone tagiem ${tag.label} w aktualnościach MeshCore Polska - newsy, poradniki i changelogi aplikacji oraz firmware MeshCore.`,
	keywords: `${tag.label}, aktualności MeshCore Polska, changelog MeshCore`,
	canonical: `/aktualnosci/${tag.slug}`,
	css: ['docs', 'news'],
	page: 'news',
	breadcrumbs: [
		{ name: 'Strona główna', url: '/' },
		{ name: 'Aktualności', url: '/aktualnosci' },
		{ name: `Tag: ${tag.label}`, url: `/aktualnosci/${tag.slug}` },
	]
}) %>

<main>
	<section class="news-hero">
		<div class="section__inner">
			<p class="eyebrow">Tag</p>
			<div class="news-hero__heading">
				<h1><%= tag.label %></h1>
				<%- include('./_search-box.ejs') %>
			</div>
			<p class="news-hero__lead"><% if (tag.description) { %><%= tag.description %> <% } %><%= tag.posts.length %> <%= pluralizePolish(tag.posts.length, { one: 'wpis', few: 'wpisy', many: 'wpisów' }) %> oznaczonych tym tagiem.</p>

			<div id="news-toolbar">
				<% if (tags.length) { %>
					<div id="news-tags">
						<a href="/aktualnosci" class="pill news-tag">Wszystkie</a>
						<% tags.forEach(t => { %>
							<a href="/aktualnosci/<%= t.slug %>" class="pill news-tag<%= t.slug === tag.slug ? ' news-tag--active' : '' %>"><%= t.label %> <span class="news-tag__count"><%= t.posts.length %></span></a>
						<% }) %>
					</div>
				<% } %>
				<a href="<%= feed.href %>" class="pill news-tag news-rss" type="application/rss+xml" title="Kanał RSS z wpisami z tagiem <%= tag.label %>"><svg class="news-rss__icon" aria-hidden="true"><use href="/icons.svg#rss"></use></svg> RSS</a>
			</div>
		</div>
	</section>

	<div class="section">
		<div class="section__inner">
			<div id="news-list">
				<% tag.posts.forEach(post => { %>
					<a href="<%= post.canonical %>" class="news-post-card panel" data-search="<%= [post.title, post.description, ...post.tags.map(t => t.label)].join(' ').toLowerCase() %>">
						<div class="news-post-card__head">
							<h2 class="card-title"><%= post.title %></h2>
							<span class="news-post-card__date">Opublikowano: <%= post.createdAt %></span>
						</div>
						<% if (post.description) { %><p class="news-post-card__desc"><%= post.description %></p><% } %>
						<div class="news-post-card__tags">
							<div class="news-post-card__tags-list">
								<% post.tags.forEach(t => { %><span class="pill news-tag"><%= t.label %></span><% }) %>
							</div>
							<span class="news-source news-source--<%= post.source.slug %>" title="<%= post.source.description %>"><%= post.source.label %></span>
						</div>
					</a>
				<% }) %>
			</div>
			<p id="news-search__empty" hidden>Brak wyników dla podanej frazy.</p>
			<div class="news-search-footer">
				<%- include('./_search-box.ejs') %>
			</div>
		</div>
	</div>
</main>

<%- include('../includes/footer.ejs', { footer: false, scripts: ['/js/news.js'] }) %>
